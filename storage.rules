rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'theangelvaldez17@gmail.com';
    }

    match /memories/{fileName} {

      // Las fotos solo están disponibles para usuarios autenticados.
      allow read: if request.auth != null;

      // Solo usuarios autenticados pueden subir, y solo imágenes
      // de hasta 10 MB (la app ya comprime a ~0.8 MB antes de subir,
      // este límite es una red de seguridad contra abuso).
      allow create, update: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Solo el propietario puede borrar fotos publicadas.
      allow delete: if isOwner();
    }

    // Bloquea todo lo demás por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
