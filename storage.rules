rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /memories/{fileName} {

      // Cualquiera con el enlace puede ver las fotos.
      // Si quieres un álbum privado de verdad, cambia esto a:
      //   allow read: if request.auth != null;
      allow read: if true;

      // Solo usuarios autenticados pueden subir, y solo imágenes
      // de hasta 10 MB (la app ya comprime a ~0.8 MB antes de subir,
      // este límite es una red de seguridad contra abuso).
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Borrar un archivo requiere estar autenticado.
      // (El control de "solo el autor puede borrar su recuerdo" ya
      // se aplica a nivel de documento en firestore.rules; aquí solo
      // evitamos que alguien anónimo borre archivos.)
      allow delete: if request.auth != null;
    }

    // Bloquea todo lo demás por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
